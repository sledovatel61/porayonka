@echo off
chcp 65001 >nul
cd /d "%~dp0"

:: Раунд 24 (задача 2): запуск web-версии Порайонки на Windows 7.
:: Раунд 37 (задача 3): bat универсален — ищет любой из двух exe (в
:: дистрибутиве лежит ровно один своей редакции).
:: Раунд 38 (задача 3.3): bat ждёт доступности сервера (до ~60 сек), а не
:: открывает браузер вслепую через 4 секунды.
::
:: ════════════════════════════════════════════════════════════════════
:: Раунд 39 (задача 3): БАТ БОЛЬШЕ НЕ ОТКРЫВАЕТ БРАУЗЕР.
:: ════════════════════════════════════════════════════════════════════
:: КОРЕНЬ «двойного открытия»: браузер открывали одновременно
::   (1) Flet внутри exe  — ft.app(view=AppView.WEB_BROWSER), и
::   (2) этот bat         — `start http://127.0.0.1:8555` после ожидания.
:: Итог — два окна браузера на один запуск.
::
:: Единственный владелец — FLET (см. BROWSER_OWNER в main.py). Роль bat'а
:: теперь ровно две вещи:
::   1) запустить сервер (exe / main_web.py);
::   2) дождаться HTTP-доступности и напечатать адрес.
:: Если Flet по какой-то причине браузер не поднял (не назначен браузер по
:: умолчанию), пользователь видит адрес здесь и открывает его сам —
:: «мёртвой» вкладки с неверным портом больше не бывает.
::
:: Повторный запуск не дублирует ни сервер, ни браузер: exe сам проверяет,
:: что порт уже обслуживается, открывает браузер (он в этом процессе —
:: единственный владелец, Flet не стартует) и завершается, а мы просто
:: сообщаем, что сервер уже работает.

set LOG=%APPDATA%\porayonka\web_startup.log

echo.
echo  Порайонка — Контроли (web-версия для Windows 7)
echo.
echo  НЕ закрывайте это окно, пока работаете с приложением.
echo.

if exist "Порайонка_Пользователь_Web.exe" (
    start "" "Порайонка_Пользователь_Web.exe"
) else if exist "Порайонка_Админ_Web.exe" (
    start "" "Порайонка_Админ_Web.exe"
) else if exist "main_web.py" (
    start "" python main_web.py
) else (
    echo  [ОШИБКА] Не найдены Порайонка_Пользователь_Web.exe /
    echo  Порайонка_Админ_Web.exe / main_web.py
    pause
    exit /b 1
)

:: Ждём, пока сервер начнёт отвечать (максимум ~60 секунд). PowerShell 2.0+
:: (есть на Win7 SP1) — HttpWebRequest в цикле.
:: Раунд 39: перебираем 8555..8564 — main_web.py при занятом 8555 уезжает на
:: следующий свободный порт, а раньше bat ждал жёстко 8555 и ошибочно
:: сообщал «сервер не ответил», хотя сервер работал.
powershell -NoProfile -ExecutionPolicy Bypass -Command "$found=0; for($i=0;$i -lt 60;$i++){ foreach($p in 8555..8564){ try { $r=[System.Net.HttpWebRequest]::Create('http://127.0.0.1:'+$p+'/'); $r.Timeout=2000; $resp=$r.GetResponse(); $resp.Close(); Write-Output $p; $found=1; break } catch {} }; if($found){ break }; Start-Sleep -Seconds 1 }; if(-not $found){ exit 1 }" > "%TEMP%\porayonka_web_port.txt" 2>&1

if errorlevel 1 (
    echo.
    echo  [ОШИБКА] Сервер не ответил за 60 секунд.
    echo  Подробности в логе запуска:
    echo  %LOG%
    echo.
    echo  Откройте лог и пришлите его администратору.
    pause
    exit /b 1
)

set /p WEBPORT=<"%TEMP%\porayonka_web_port.txt"
del "%TEMP%\porayonka_web_port.txt" >nul 2>&1
if "%WEBPORT%"=="" set WEBPORT=8555

echo  Сервер запущен и отвечает.
echo.
echo  Адрес приложения:  http://127.0.0.1:%WEBPORT%
echo.
echo  Браузер открывает само приложение. Если окно браузера не
echo  появилось — откройте адрес выше вручную.
echo.
